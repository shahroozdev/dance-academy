// Prisma schema for Malhaar Dance Company Management System
// See docs/02-database-schema.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

enum AdminRole {
  OWNER
  STAFF
}

enum ContentRole {
  OWNER
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContentUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         ContentRole @default(EDITOR)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([isActive])
}

// ---------- Families & Students ----------

model Family {
  id                 String                @id @default(cuid())
  familyName         String
  parentGuardianName String
  email              String?
  phone              String
  isActive           Boolean               @default(true)
  notes              String?
  students           Student[]
  guardians          FamilyGuardian[]
  registrationReqs   RegistrationRequest[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([phone])
  @@index([email])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Student {
  id                           String                  @id @default(cuid())
  fullName                     String
  familyId                     String
  family                       Family                  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  dob                          DateTime?
  gender                       Gender?
  joinDate                     DateTime                @default(now())
  isActive                     Boolean                 @default(true)
  medicalNotes                 String?
  generalNotes                 String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyPhone               String?
  enrollments                  Enrollment[]
  monthlyBillings              MonthlyStudentBilling[]
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([familyId])
  @@index([isActive])
}

// ---------- Teachers ----------

model Teacher {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean   @default(true)
  classes   Class[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
}

// ---------- Programs, Classes & Enrollments ----------

model DanceProgram {
  id                   String                @id @default(cuid())
  name                 String                @unique
  description          String?
  isActive             Boolean               @default(true)
  classes              Class[]
  registrationRequests RegistrationRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([isActive])
}

model FamilyGuardian {
  id                    String   @id @default(cuid())
  familyId              String
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name                  String
  relationship          String?
  email                 String?
  phone                 String?
  isPrimary             Boolean  @default(false)
  receivesNotifications Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([familyId])
}

enum PricingType {
  REGULAR
  SEASONAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ExtraSessionBillingUnit {
  SESSION
  HOUR
}

model Class {
  id                   String                @id @default(cuid())
  name                 String
  programId            String
  program              DanceProgram          @relation(fields: [programId], references: [id], onDelete: Restrict)
  level                String?
  teacherId            String?
  teacher              Teacher?              @relation(fields: [teacherId], references: [id])
  dayOfWeek            DayOfWeek?
  firstClassDate       DateTime              @db.Date
  startTime            String?
  endTime              String?
  durationMins         Int?
  standardRate         Decimal               @db.Decimal(10, 2)
  pricingType          PricingType           @default(REGULAR)
  discountEligible     Boolean               @default(true)
  // Soft cap only — enrollment.ts still allows enrolling past it, just with a UI warning. No
  // waitlist concept; the doc never specifies a max class size and ~50 total students studio-wide
  // makes an actual queue unlikely to be needed.
  capacity             Int?
  isActive             Boolean               @default(true)
  // First calendar month that must not be billed after the class is deactivated. Historical
  // months before this boundary remain available for corrections and reporting.
  inactiveFromMonth    DateTime?              @db.Date
  enrollments          Enrollment[]
  monthlyFees          ClassMonthlyFee[]
  extraSessions        ClassExtraSession[]
  billingPauses        ClassBillingPause[]
  registrationRequests RegistrationRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([isActive])
  @@index([programId])
  @@index([teacherId])
}

model ClassExtraSession {
  id          String                  @id @default(cuid())
  classId     String
  class       Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionDate DateTime                @db.Date
  title       String
  billingUnit ExtraSessionBillingUnit @default(SESSION)
  quantity    Decimal                 @db.Decimal(8, 2)
  rate        Decimal                 @db.Decimal(10, 2)
  amount      Decimal                 @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([classId, sessionDate])
}

model ClassBillingPause {
  id         String   @id @default(cuid())
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  startMonth DateTime @db.Date
  endMonth   DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  @@index([classId])
  @@index([startMonth, endMonth])
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

model Enrollment {
  id               String                   @id @default(cuid())
  studentId        String
  student          Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId          String
  class            Class                    @relation(fields: [classId], references: [id], onDelete: Restrict)
  startDate        DateTime                 @db.Date
  endDate          DateTime?                @db.Date
  status           EnrollmentStatus         @default(ACTIVE)
  billingLineItems MonthlyBillingLineItem[]
  billingPauses    EnrollmentBillingPause[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([studentId, classId, startDate])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model EnrollmentBillingPause {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  startMonth   DateTime   @db.Date
  endMonth     DateTime   @db.Date
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
  @@index([startMonth, endMonth])
}

// ---------- Class Monthly Fees (historical pricing snapshot) ----------

model ClassMonthlyFee {
  id               String                   @id @default(cuid())
  classId          String
  class            Class                    @relation(fields: [classId], references: [id], onDelete: Restrict)
  month            DateTime
  billableSessions Int?
  rate             Decimal?                 @db.Decimal(10, 2)
  flatFee          Decimal?                 @db.Decimal(10, 2)
  monthlyClassFee  Decimal                  @db.Decimal(10, 2)
  // Teacher-entered count is a draft. It does not change bills until staff explicitly applies it.
  reportedSessions Int?
  reportNotes      String?
  reportedAt       DateTime?
  isOverridden     Boolean                  @default(false)
  // Staff confirmation that this class's billable session count for the month is correct.
  // Fee notifications for any bill referencing this row are blocked until it's finalized —
  // see docs/04-business-logic-billing-discounts.md §4.7.
  isFinalized      Boolean                  @default(false)
  finalizedAt      DateTime?
  notes            String?
  lineItems        MonthlyBillingLineItem[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([classId, month])
  @@index([month])
}

// ---------- Monthly Student Billing ----------

enum BillingStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERPAID
}

enum NotificationStatus {
  NOT_SENT
  SENT
  FAILED
}

model MonthlyStudentBilling {
  id                 String                   @id @default(cuid())
  studentId          String
  student            Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  month              DateTime
  baseTuition        Decimal                  @db.Decimal(10, 2)
  multiClassDiscount Decimal                  @default(0) @db.Decimal(10, 2)
  siblingDiscount    Decimal                  @default(0) @db.Decimal(10, 2)
  adjustment         Decimal                  @default(0) @db.Decimal(10, 2)
  adjustmentNotes    String?
  finalAmountDue     Decimal                  @db.Decimal(10, 2)
  amountPaid         Decimal                  @default(0) @db.Decimal(10, 2)
  balance            Decimal                  @db.Decimal(10, 2)
  status             BillingStatus            @default(DRAFT)
  notificationStatus NotificationStatus       @default(NOT_SENT)
  notificationSentAt DateTime?
  // Set once a payment-reminder cron run (§5.4) has sent a reminder for this bill — a bill only
  // ever gets one automated reminder, not a fresh one every day it stays overdue.
  reminderSentAt     DateTime?
  needsManualReview  Boolean                  @default(false)
  manualReviewReason String?
  manualReviewAt     DateTime?
  lineItems          MonthlyBillingLineItem[]
  payments           Payment[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([studentId, month])
  @@index([month])
  @@index([status])
  @@index([needsManualReview])
}

model MonthlyBillingLineItem {
  id                String                @id @default(cuid())
  billingId         String
  billing           MonthlyStudentBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  enrollmentId      String
  enrollment        Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  classMonthlyFeeId String
  classMonthlyFee   ClassMonthlyFee       @relation(fields: [classMonthlyFeeId], references: [id], onDelete: Restrict)
  amount            Decimal               @db.Decimal(10, 2)

  @@unique([billingId, enrollmentId])
}

// ---------- Payments ----------

enum PaymentMethod {
  ZELLE
  CASH
  CHECK
  OTHER
}

model Payment {
  id          String                @id @default(cuid())
  billingId   String
  billing     MonthlyStudentBilling @relation(fields: [billingId], references: [id], onDelete: Restrict)
  paymentDate DateTime
  amount      Decimal               @db.Decimal(10, 2)
  method      PaymentMethod
  reference   String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([billingId])
  @@index([paymentDate])
}

// ---------- Registration Requests ----------

enum RegistrationStatus {
  PENDING
  PROCESSED
  REJECTED
}

model RegistrationRequest {
  id                           String             @id @default(cuid())
  parentGuardianName           String
  parentEmail                  String?
  parentPhone                  String
  studentFullName              String
  dob                          DateTime?
  gender                       Gender?
  requestedProgramId           String?
  requestedProgram             DanceProgram?      @relation(fields: [requestedProgramId], references: [id], onDelete: Restrict)
  requestedClassId             String?
  requestedClass               Class?             @relation(fields: [requestedClassId], references: [id])
  previousDanceExperience      String?
  emergencyContactName         String
  emergencyContactRelationship String
  emergencyPhone               String
  studioPolicyAgreement        Boolean            @default(false)
  photoVideoConsent            Boolean            @default(false)
  status                       RegistrationStatus @default(PENDING)
  matchedFamilyId              String?
  matchedFamily                Family?            @relation(fields: [matchedFamilyId], references: [id])
  matchedStudentId             String?
  processedByAdminId           String?
  processedAt                  DateTime?
  enrollmentConfirmationSentAt DateTime?
  policyTitleSnapshot          String?
  policyContentSnapshot        String?            @db.Text
  policyAgreementLabelSnapshot String?
  policyVersion                Int?
  policyAgreedAt               DateTime?
  createdAt                    DateTime           @default(now())

  @@index([status])
  @@index([requestedProgramId])
}

// ---------- Expenses & Other Income ----------

enum ExpenseCategory {
  STUDIO_RENT
  INSTRUCTOR_CHOREOGRAPHER
  COSTUMES
  JEWELRY_PROPS
  COMPETITION_EVENT_FEES
  ADVERTISING
  SOFTWARE_SUBSCRIPTIONS
  MUSIC_EDITING
  SUPPLIES
  TRAVEL
  MISCELLANEOUS
}

model Expense {
  id            String          @id @default(cuid())
  date          DateTime
  category      ExpenseCategory
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  notes         String?
  receiptUrl    String?
  // Optional — mainly meaningful for INSTRUCTOR_CHOREOGRAPHER expenses, but not restricted to
  // that category, since a teacher could reasonably be paid for e.g. a workshop under a different
  // category too. Lets the Teacher detail page answer "what did we pay this person" directly.
  teacherId     String?
  teacher       Teacher?        @relation(fields: [teacherId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([teacherId])
}

enum OtherIncomeCategory {
  REGISTRATION_FEE
  WORKSHOP_CAMP
  PERFORMANCE_FEE
  COSTUME_INCOME
  PRIVATE_LESSON
  MISCELLANEOUS
}

model OtherIncome {
  id            String              @id @default(cuid())
  date          DateTime
  category      OtherIncomeCategory
  description   String
  amount        Decimal             @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([date])
  @@index([category])
}

// ---------- Studio Settings (singleton) ----------

enum FontSize {
  SMALL
  MEDIUM
  LARGE
}

model StudioSettings {
  id             String   @id @default("default")
  primaryColor   String   @default("#9B1B5E")
  secondaryColor String   @default("#F5D0E0")
  accentColor    String   @default("#E8A0D0")
  fontSize       FontSize @default(MEDIUM)
  logoUrl        String?
  studioName     String?  @default("Malhaar Dance Company")
  registrationPolicyTitle          String @default("Regular Class Guide — 2026–2027 Academic Year")
  registrationPolicyContent        String @db.Text
  registrationPolicyAgreementLabel String @default("I have read and agree to the studio's policies and procedures.")
  registrationPolicyVersion        Int    @default(1)

  // Discount policy (§4.4) — was env-only (DISCOUNT_MULTI_CLASS_PCT/DISCOUNT_SIBLING_PCT), now admin-editable
  multiClassDiscountPct Decimal @default(0.05) @db.Decimal(5, 4)
  siblingDiscountPct    Decimal @default(0.05) @db.Decimal(5, 4)

  // Billing due date + payment reminder timing (§5.4, §3.14) — day-of-month a bill is considered
  // due, and how many days past that a bill must sit UNPAID/PARTIAL before the reminder cron nudges it
  dueDayOfMonth               Int @default(5)
  paymentReminderDaysAfterDue Int @default(7)

  // Owner alert sent after the scheduled monthly job prepares bills for staff review.
  billingAlertEnabled Boolean @default(true)
  billingAlertEmail   String?
  parentNotificationAlertEnabled Boolean @default(true)
  registrationAlertEnabled Boolean @default(true)
  paymentRecordedAlertEnabled Boolean @default(true)
  creditAlertEnabled Boolean @default(true)
  billingFailureAlertEnabled Boolean @default(true)
  parentNotificationFailureAlertEnabled Boolean @default(true)
  paymentReminderFailureAlertEnabled Boolean @default(true)
  unfinalizedFeeAlertEnabled Boolean @default(true)
  lastUnfinalizedFeeAlertMonth DateTime?

  // SMTP / email (was env-only SMTP_*/EMAIL_FROM) — smtpPassword is a secret, never returned to the client as-is
  smtpHost     String?
  smtpPort     Int?    @default(587)
  smtpSecure   Boolean @default(false)
  smtpUser     String?
  smtpPassword String?
  emailFrom    String?

  // WhatsApp Cloud API / Meta (was env-only WHATSAPP_*) — whatsappAccessToken is a secret, never returned to the client as-is
  whatsappAccessToken       String?
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Email Templates ----------
//
// The customizable part of each outbound email — subject + body text with {{placeholder}} tokens
// (see src/lib/email-templates.ts for the fixed set of keys/placeholders per template). The
// surrounding HTML (theme-colored header with logo, footer) is NOT stored here — it's a fixed
// shell built by src/lib/email-html.ts from StudioSettings, not admin-editable.

enum EmailTemplateKey {
  REGISTRATION_RECEIVED
  ENROLLMENT_CONFIRMED
  MONTHLY_FEE_NOTICE
  PAYMENT_REMINDER
}

model EmailTemplate {
  key       EmailTemplateKey @id
  subject   String
  body      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// ---------- Notification Log ----------

enum NotificationChannel {
  WHATSAPP
  EMAIL
  MANUAL
}

model NotificationLog {
  id                String              @id @default(cuid())
  familyId          String
  month             DateTime
  channel           NotificationChannel
  status            NotificationStatus  @default(NOT_SENT)
  messageContent    String
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([familyId, month])
}

// ---------- Website content (Content Portal) ----------
//
// Managed only from /content — see docs/content-portal-plan.md. Nothing here relates to
// students, families, billing, or the admin tables. "Who did it" columns hold a ContentUser id
// and a name snapshot rather than a relation, so the record survives changes to that account.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaAssetKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum FestivalMediaRole {
  POSTER
  GALLERY
  VIDEO
  SPONSOR
}

enum PressItemKind {
  COVERAGE
  INTERVIEW
  FEATURE
  VIDEO
  APPEARANCE
}

model MediaAsset {
  id               String             @id @default(cuid())
  kind             MediaAssetKind
  url              String
  title            String
  altText          String             @default("")
  attribution      String?
  // Focal point as a percentage of the width/height, used to keep the subject in frame when cropped.
  focalX           Int                @default(50)
  focalY           Int                @default(50)
  contentType      String?
  sizeBytes        Int?
  uploadedById     String?
  uploadedByName   String?
  festivalMedia    FestivalMedia[]
  festivalArtists  FestivalArtist[]
  performances     Performance[]
  performanceMedia PerformanceMedia[]
  pressImages      PressItem[]        @relation("PressItemImage")
  pressDocuments   PressItem[]        @relation("PressItemDocument")
  profiles         PublicProfile[]
  siteSlots        SiteMediaSlot[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([kind])
}

model Festival {
  id              String           @id @default(cuid())
  year            String           @unique
  label           String
  eventDate       DateTime         @db.Date
  // 24-hour "HH:mm" in the studio's local (US Central) time.
  startTime       String
  venueName       String
  venueTown       String
  venueRegion     String           @default("IL")
  venueStreet     String?
  venuePostalCode String?
  summary         String           @db.Text
  ticketUrl       String?
  status          ContentStatus    @default(DRAFT)
  publishedAt     DateTime?
  publishedById   String?
  publishedByName String?
  artists         FestivalArtist[]
  media           FestivalMedia[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
}

model FestivalArtist {
  id         String      @id @default(cuid())
  festivalId String
  festival   Festival    @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  name       String
  artForm    String
  biography  String?     @db.Text
  photoId    String?
  photo      MediaAsset? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  sortOrder  Int         @default(0)

  @@index([festivalId])
}

model FestivalMedia {
  id         String            @id @default(cuid())
  festivalId String
  festival   Festival          @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  assetId    String
  asset      MediaAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  role       FestivalMediaRole
  caption    String?
  linkUrl    String?
  sortOrder  Int               @default(0)

  @@index([festivalId])
  @@index([assetId])
}

model Performance {
  id              String             @id @default(cuid())
  slug            String             @unique
  title           String
  eventDate       DateTime?          @db.Date
  venue           String?
  summary         String             @db.Text
  description     String?            @db.Text
  coverId         String?
  cover           MediaAsset?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  videoUrl        String?
  externalUrl     String?
  status          ContentStatus      @default(DRAFT)
  publishedAt     DateTime?
  publishedById   String?
  publishedByName String?
  media           PerformanceMedia[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

model PerformanceMedia {
  id            String      @id @default(cuid())
  performanceId String
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  assetId       String
  asset         MediaAsset  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  caption       String?
  sortOrder     Int         @default(0)

  @@index([performanceId])
  @@index([assetId])
}

model PressItem {
  id              String        @id @default(cuid())
  title           String
  outlet          String?
  kind            PressItemKind @default(COVERAGE)
  publishedOn     DateTime?     @db.Date
  excerpt         String?       @db.Text
  externalUrl     String?
  imageId         String?
  image           MediaAsset?   @relation("PressItemImage", fields: [imageId], references: [id], onDelete: SetNull)
  documentId      String?
  document        MediaAsset?   @relation("PressItemDocument", fields: [documentId], references: [id], onDelete: SetNull)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  publishedById   String?
  publishedByName String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model PublicProfile {
  id              String      @id @default(cuid())
  name            String
  title           String
  summary         String      @db.Text
  biography       String      @db.Text
  specializations String[]
  photoId         String?
  photo           MediaAsset? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  // Explicit switch: a profile is only ever shown on the website while this is on.
  isVisible       Boolean     @default(false)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isVisible])
}

model WebsiteSettings {
  id             String   @id @default("default")
  contactEmail   String
  contactPhone   String
  whatsappUrl    String?
  facebookUrl    String?
  instagramUrl   String?
  seoDescription String   @db.Text
  homeIntro      String   @db.Text
  updatedByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContentAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// A fixed place on the website that shows one Media Library file — the home page's opening
// video, the founders' photo, each training program's picture. The keys are defined in
// src/lib/site-media.ts; a place with no row here shows the file that ships with the site.
model SiteMediaSlot {
  key           String     @id
  assetId       String
  asset         MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  updatedByName String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([assetId])
}

// ---------- Website inquiries ----------
//
// Messages sent from the public contact form. Read and handled in the Content Portal; nothing
// here is linked to families, students, or registrations.

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Inquiry {
  id                String        @id @default(cuid())
  name              String
  email             String
  phone             String?
  studentName       String?
  studentAge        String?
  interestedIn      String
  preferredLocation String?
  message           String        @db.Text
  status            InquiryStatus @default(NEW)
  // Whether the staff email alert for this inquiry went out; the inquiry is kept either way.
  emailAlertSent    Boolean       @default(false)
  // A one-way fingerprint of the sender's network address, used only to limit how many messages
  // one visitor can send in an hour. The address itself is never stored.
  senderKey         String?
  handledByName     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([senderKey, createdAt])
}
