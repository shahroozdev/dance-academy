ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

FAILED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch — nothing to lint.
  [ "$local_sha" = "$ZERO_SHA" ] && continue

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # New branch/upstream: nothing to diff against yet, so lint everything
    # being pushed against git's empty-tree object.
    FROM="$EMPTY_TREE"
  else
    FROM="$remote_sha"
  fi

  echo "Running lint-staged on changes in $local_ref ($FROM..$local_sha)..."
  if ! npx lint-staged --diff="$FROM..$local_sha"; then
    FAILED=1
  fi
done

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "ESLint found errors that autofix could not resolve."
  echo "Fix the issues above, commit (or amend), and push again."
  exit 1
fi

sh "$(dirname "$0")/../scripts/husky/check-migrations.sh"
