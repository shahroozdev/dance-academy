ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

FAILED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch — nothing to lint.
  [ "$local_sha" = "$ZERO_SHA" ] && continue

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    # New branch/upstream: nothing to diff against yet, so lint everything
    # being pushed against git's empty-tree object.
    FROM="$EMPTY_TREE"
  else
    FROM="$remote_sha"
  fi

  echo "Running lint-staged on changes in $local_ref ($FROM..$local_sha)..."
  # --max-arg-length: lint-staged's own default budget for Windows (8191, the cmd.exe limit)
  # doesn't leave room for the extra wrapper cmd.exe adds when it re-invokes a .cmd shim like
  # node_modules/.bin/eslint.cmd, so a large changeset (e.g. 100+ files) can still overflow even
  # after lint-staged's automatic chunking. A lower budget forces smaller chunks with headroom.
  if ! npx lint-staged --diff="$FROM..$local_sha" --max-arg-length 4096; then
    FAILED=1
  fi
done

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "ESLint found errors that autofix could not resolve."
  echo "Fix the issues above, commit (or amend), and push again."
  exit 1
fi
